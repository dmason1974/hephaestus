# --- SSH tunnel (Lightsail bastion -> RDS) ---
# Run `npm run db:tunnel` to open this before connecting.
SSH_TUNNEL_HOST=furiosa-prod    # matches the alias already in ~/.ssh/config
RDS_ENDPOINT=furiosa-db.c43i6su88bsx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
LOCAL_TUNNEL_PORT=5433          # must match PGPORT below

# --- Postgres connection (through the tunnel, i.e. localhost) ---
PGHOST=localhost
PGPORT=5433
PGDATABASE=                     # new db on this instance, not furyroad -- fill in once created
PGUSER=
PGPASSWORD=
