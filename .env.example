# --- SSH tunnel (Lightsail bastion -> RDS) ---
# Run `npm run db:tunnel` to open this before connecting.
SSH_TUNNEL_HOST=furiosa-prod    # matches the alias already in ~/.ssh/config
RDS_ENDPOINT=furiosa-db.c43i6su88bsx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
LOCAL_TUNNEL_PORT=5433          # must match PGPORT below

# --- Postgres connection (through the tunnel, i.e. localhost) ---
PGHOST=localhost
PGPORT=5433
PGDATABASE=hephaestus          # created by `npm run db:create`; schema applied by `npm run db:migrate`
PGUSER=
PGPASSWORD=

# --- Notion (Unit 4 render harness: npm run smoke:eco-plan-notion) ---
# Create an internal integration at notion.so/my-integrations, share the
# parent page below with it, then paste its token here.
NOTION_API_KEY=
# Page ID (or full URL) of the Notion page to create per-country eco-plan
# report pages under.
NOTION_PARENT_PAGE_ID=
