{
  "name": "ww3-build-plan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:country": "node --import tsx src/validation/validateCountryFile.ts",
    "validate:countries": "node --import tsx src/validation/validateAllCountries.ts",
    "smoke:morale": "node --import tsx src/sim/build-order/scenarios/morale.scenario.ts",
    "smoke:resource": "node --import tsx src/sim/build-order/scenarios/resource.scenario.ts",
    "smoke:resource:hourly": "node --import tsx src/sim/build-order/scenarios/hourly-resource.scenario.ts",
    "smoke:argentina:hourly": "node --import tsx src/sim/build-order/scenarios/argentina-hourly.scenario.ts",
    "smoke:build-order": "node --import tsx src/sim/build-order/scenarios/build-order.scenario.ts",
    "smoke:multipliers": "node --import tsx src/sim/build-order/scenarios/multipliers.scenario.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
